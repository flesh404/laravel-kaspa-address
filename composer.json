{
  "name": "flesh404/laravel-kaspa-address",
  "description": "Laravel package for validating and analyzing Kaspa addresses",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Flesh404\\Kaspa\\Laravel\\Address\\": "src/"
    }
  },
  "require": {
    "php": "^8.1",
    "illuminate/support": "^10.0|^11.0"
  },
  "require-dev": {
    "roave/security-advisories": "dev-latest",
    "orchestra/testbench": "^8.0|^9.0",
    "phpunit/phpunit": "^10.0"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Flesh404\\Kaspa\\Laravel\\Address\\Providers\\KaspaAddressServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable"
}